{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and serial-debug-filter subwindow",
  "windows": ["main", "serial-debug-filter"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load",
    "process:allow-exit",
    "process:allow-restart",
    "log:default"
  ]
}
