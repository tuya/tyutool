# ── Node / pnpm ───────────────────────────────────────────────────────────────
node_modules/
dist/
.pnpm-store/
package-lock.json
.vite/

# ── Rust / Cargo ──────────────────────────────────────────────────────────────
target/

# Bridge packaging scratch: `out/` is where the workflow stages the built binary
# for cargo-packager to consume, `installers/` is where the .dmg/.exe/.deb land.
# Both are reproducible build output and are recreated on every run.
out/
installers/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Vitest coverage ───────────────────────────────────────────────────────────
coverage/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Temp / scratch ────────────────────────────────────────────────────────────
tmp/
.tmp/

# ── Environment overrides (never commit secrets) ──────────────────────────────
.env.local
.env.*.local

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Linux ─────────────────────────────────────────────────────────────────────
.tags

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Scripts generated assets ──────────────────────────────────────────────────
scripts/icon-source.png

